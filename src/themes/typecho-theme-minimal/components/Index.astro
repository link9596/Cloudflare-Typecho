---
/**
 * Default theme — Index (home page) component
 * 微博风格卡片，无标题，点击卡片进入详情（内部链接独立）
 * 支持图片网格：1张自适应、2张并排、3张三列、4张2x2、5张及以上三列
 * 新增：点击图片弹出灯箱（带缩放动画）
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { formatDate, buildAuthorLink } from '@/lib/content';
import { createHash } from 'node:crypto';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, sidebarData, currentPath, pluginCtx,
  posts, pagination,
} = Astro.props;

const isIndex = currentPath === '/';

const processPost = (post: any) => {
  const imgRegex = /<img[^>]+src="([^">]+)"/g;
  let match;
  const images: string[] = [];
  let excerpt = post.excerpt || '';
  while ((match = imgRegex.exec(excerpt)) !== null) {
    images.push(match[1]);
  }
  if (images.length > 0) {
    excerpt = excerpt.replace(/<img[^>]+>/g, '').trim();
  }

  const email = post.author?.mail || '';
  let avatarUrl = 'https://seccdn.libravatar.org/avatar/17885ae2e792de13ef1b68309799f7e4?d=404';
  if (email) {
    const hash = createHash('md5').update(email.trim().toLowerCase()).digest('hex');
    avatarUrl = `https://www.gravatar.com/avatar/${hash}?s=48&d=identicon`;
  }

  return { ...post, images, excerpt, avatarUrl, imageCount: images.length };
};

const processedPosts = posts.map(processPost);
---

<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <header id="header" class="clearfix">
    <div class="container">
      <div class="row">
        <div class="site-name col-mb-12 col-9">
          <a id="logo" href={urls.siteUrl + '/'}>{options.title}</a>
          <p class="description">{options.description}</p>
        </div>
        <div class="site-search col-3 kit-hidden-tb">
          <form id="search" method="post" action={urls.siteUrl + '/'} role="search">
            <label for="s" class="sr-only">搜索关键字</label>
            <input type="text" id="s" name="s" class="text" placeholder="输入关键字搜索" />
            <button type="submit" class="submit">搜索</button>
          </form>
        </div>
        <div class="col-mb-12">
          <nav id="nav-menu" class="clearfix" role="navigation">
            <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>首页</a>
            {pages.map((page) => (
              <a href={page.permalink} title={page.title}>{page.title}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div id="body">
    <div class="container">
      <div class="row">
        <div class="col-mb-12 col-8" id="main" role="main">
          {processedPosts.length === 0 ? (
            <article class="post">
              <h2 class="post-title">暂时没有文章</h2>
              <div class="post-content">
                <p>这里还没有任何文章，请通过管理后台发布第一篇文章。</p>
              </div>
            </article>
          ) : (
            processedPosts.map((post) => (
              <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
                <div class="post-card" style="position: relative; padding: 16px 0; border-bottom: 1px solid #eaecef;">
                  <!-- 覆盖链接 -->
                  <a href={post.permalink} class="card-overlay" style="position: absolute; inset: 0; z-index: 1; display: block; cursor: pointer;"></a>

                  <!-- 头像 + 元数据（两行） -->
                  <div class="post-header" style="display: flex; align-items: flex-start; gap: 12px; position: relative; z-index: 2;">
                    <div class="post-avatar" style="flex-shrink: 0; width: 48px; height: 48px;">
                      <img
                        src={post.avatarUrl}
                        alt={post.author?.screenName || '用户'}
                        style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"
                      />
                    </div>
                    <div class="meta-block" style="flex: 1; min-width: 0;">
                      <div class="post-author" style="font-weight: 600; font-size: 15px; color: #3354aa; margin-bottom: 2px;">
                        <a
                          itemprop="name"
                          href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                          rel="author"
                          style="color: inherit; text-decoration: none; position: relative; z-index: 3;"
                        >
                          {post.author?.screenName || post.author?.name || '未知'}
                        </a>
                      </div>
                      <div class="post-meta-details" style="font-size: 14px; color: #8a8f9a; display: flex; flex-wrap: wrap; gap: 2px 6px;">
                        <time datetime={new Date((post.created) * 1000).toISOString()} itemprop="datePublished">
                          {formatDate(post.created, 'Y.m.d H:i', options.timezone)}
                        </time>
                        {post.categories.length > 0 && (
                          <>
                            <span class="sep" style="color: #d0d4dc;">·</span>
                            {post.categories.map((c, i) => (
                              <span key={c.cid} style="position: relative; z-index: 3;">
                                {i > 0 && ', '}
                                <a href={c.permalink} style="color: #8a8f9a; text-decoration: none;">{c.name}</a>
                              </span>
                            ))}
                          </>
                        )}
                        <span class="sep" style="color: #d0d4dc;">·</span>
                        <a
                          href={`${post.permalink}#comments`}
                          itemprop="discussionUrl"
                          style="color: #8a8f9a; text-decoration: none; position: relative; z-index: 3;"
                        >
                          {post.commentsNum === 0 ? '评论' : `${post.commentsNum} 条评论`}
                        </a>
                      </div>
                    </div>
                  </div>

                  <!-- 摘要 -->
                  <div
                    class="post-excerpt"
                    itemprop="articleBody"
                    set:html={post.excerpt}
                    style="margin-top: 8px; padding-left: 60px; font-size: 15px; line-height: 1.7; color: #4e5969; word-break: break-word;"
                  />

                  <!-- 图片网格 -->
                  {post.images.length > 0 && (
                    <div
                      class="post-images"
                      data-count={post.imageCount}
                      style="margin-top: 12px; margin-left: 60px; display: grid; gap: 4px; border-radius: 8px; overflow: hidden; max-width: 50%;"
                    >
                      {post.images.map((src: string) => (
                        <img
                          src={src}
                          alt="文章配图"
                          loading="lazy"
                          style="width: 100%; object-fit: cover; display: block; cursor: pointer;"
                        />
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))
          )}

          {pagination.totalPages > 1 && (
            <nav class="page-navigator">
              {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
              {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
            </nav>
          )}
        </div>

        <!-- 侧边栏（完整保留） -->
        {sidebarData && (
          <div class="col-mb-12 col-offset-1 col-3 kit-hidden-tb" id="secondary" role="complementary">
            {sidebarData.recentPosts && sidebarData.recentPosts.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">最新文章</h3>
                <ul class="widget-list">
                  {sidebarData.recentPosts.map((p) => (
                    <li><a href={p.permalink}>{p.title}</a></li>
                  ))}
                </ul>
              </section>
            )}
            {sidebarData.recentComments && sidebarData.recentComments.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">最近回复</h3>
                <ul class="widget-list">
                  {sidebarData.recentComments.map((c) => (
                    <li><a href={c.permalink}>{c.author}</a>: {c.excerpt}</li>
                  ))}
                </ul>
              </section>
            )}
            {sidebarData.categories && sidebarData.categories.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">分类</h3>
                <ul class="widget-list">
                  {sidebarData.categories.map((cat) => (
                    <li><a href={cat.permalink}>{cat.name} ({cat.count})</a></li>
                  ))}
                </ul>
              </section>
            )}
            {sidebarData.archives && sidebarData.archives.length > 0 && (
              <section class="widget">
                <h3 class="widget-title">归档</h3>
                <ul class="widget-list">
                  {sidebarData.archives.map((archive) => (
                    <li><a href={archive.permalink}>{archive.date}</a></li>
                  ))}
                </ul>
              </section>
            )}
            <section class="widget">
              <h3 class="widget-title">其它</h3>
              <ul class="widget-list">
                {isLoggedIn ? (
                  <>
                    <li class="last">
                      <a href={urls.adminUrl}>进入后台 ({user?.screenName || user?.name})</a>
                    </li>
                    <li><form method="post" action={urls.logoutUrl} class="logout-form"><button type="submit">退出</button></form></li>
                  </>
                ) : (
                  <li class="last"><a href={urls.loginUrl}>登录</a></li>
                )}
                <li><a href={urls.feedUrl}>文章 RSS</a></li>
                <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
              </ul>
            </section>
          </div>
        )}
      </div>
    </div>
  </div>

  <footer id="footer" role="contentinfo">
    &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a>.
    由 <a href="https://github.com/eslizn/typecho-cf">Typecho CF</a> 强力驱动.
  </footer>
</Base>

<style>
/* 覆盖层透明 */
.card-overlay {
  z-index: 1;
}

/* 内部链接置于上层 */
.post-author a,
.post-meta-details a,
.post-meta-details span a {
  position: relative;
  z-index: 3;
}

/* 图片网格布局 */
.post-images[data-count="1"] {
  grid-template-columns: 1fr;
}
.post-images[data-count="1"] img {
  max-height: 300px;
  width: auto;
  margin: 0 auto;
}

.post-images[data-count="2"] {
  grid-template-columns: 1fr 1fr;
}
.post-images[data-count="2"] img {
  aspect-ratio: 1 / 1;
}

/* 三张及以上默认三列（除了四张特殊处理） */
.post-images[data-count="3"],
.post-images[data-count="5"],
.post-images[data-count="6"],
.post-images[data-count="7"],
.post-images[data-count="8"],
.post-images[data-count="9"] {
  grid-template-columns: repeat(3, 1fr);
}
.post-images[data-count="3"] img,
.post-images[data-count="5"] img,
.post-images[data-count="6"] img,
.post-images[data-count="7"] img,
.post-images[data-count="8"] img,
.post-images[data-count="9"] img {
  aspect-ratio: 1 / 1;
}

/* 四张图片：2x2 四宫格 */
.post-images[data-count="4"] {
  grid-template-columns: 1fr 1fr;
}
.post-images[data-count="4"] img {
  aspect-ratio: 1 / 1;
}

.post-images img {
  transition: transform 0.2s ease;
  cursor: pointer;
}
.post-images img:hover {
  transform: scale(1.02);
}

/* ========== 灯箱样式（新增） ========== */
.lightbox-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.lightbox-overlay.active {
  opacity: 1;
  visibility: visible;
}

.lightbox-image {
  max-width: 90vw;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 4px;
  transform: scale(0.8);
  opacity: 0;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.35s ease;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}

.lightbox-overlay.active .lightbox-image {
  transform: scale(1);
  opacity: 1;
}

.lightbox-close {
  position: absolute;
  top: 24px;
  right: 30px;
  font-size: 36px;
  color: #fff;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 0.2s;
  z-index: 10000;
  font-family: sans-serif;
  background: none;
  border: none;
  padding: 0;
}
.lightbox-close:hover {
  opacity: 1;
}

/* 响应式调整 */
@media (max-width: 768px) {
  .post-images {
    max-width: 100% !important;
    margin-left: 0 !important;
  }
  .post-excerpt {
    padding-left: 0 !important;
  }
  .post-header {
    flex-wrap: wrap;
  }
  .lightbox-image {
    max-width: 95vw;
    max-height: 85vh;
  }
}
</style>

<!-- ========== 灯箱 JavaScript（新增） ========== -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 创建灯箱 DOM 结构
    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    overlay.innerHTML = `
      <button class="lightbox-close" aria-label="关闭">&times;</button>
      <img class="lightbox-image" src="" alt="大图预览" />
    `;
    document.body.appendChild(overlay);

    const imgEl = overlay.querySelector('.lightbox-image');
    const closeBtn = overlay.querySelector('.lightbox-close');

    // 打开灯箱
    function openLightbox(src) {
      imgEl.src = src;
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden'; // 禁止滚动
    }

    // 关闭灯箱
    function closeLightbox() {
      overlay.classList.remove('active');
      document.body.style.overflow = '';
      // 延迟清空 src 避免闪动
      setTimeout(() => {
        if (!overlay.classList.contains('active')) {
          imgEl.src = '';
        }
      }, 400);
    }

    // 事件监听：点击所有文章配图
    document.addEventListener('click', function (e) {
      const target = e.target;
      if (target.tagName === 'IMG' && target.closest('.post-images')) {
        e.preventDefault();
        e.stopPropagation(); // 防止触发卡片跳转
        const src = target.getAttribute('src');
        if (src) openLightbox(src);
      }
    });

    // 点击背景关闭
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay || e.target === closeBtn) {
        closeLightbox();
      }
    });

    // ESC 键关闭
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('active')) {
        closeLightbox();
      }
    });
  });
</script>
