---
import type { SiteOptions } from '@/lib/options';
import type { computeUrls } from '@/lib/options';
import type { UserRow } from '@/lib/context';
import { getThemeStylesheets } from '@/lib/theme';
import { getClientSnippets, type PageContext, type HookContext } from '@/lib/plugin';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  options: SiteOptions;
  urls: ReturnType<typeof computeUrls>;
  user?: UserRow | null;
  isLoggedIn?: boolean;
  bodyClass?: string;
  pageContext?: PageContext;
  pluginCtx?: HookContext;
}

const {
  title,
  description,
  keywords,
  options,
  urls,
  user,
  isLoggedIn = false,
  bodyClass = '',
  pageContext,
  pluginCtx,
} = Astro.props;

const pageTitle = title ? `${title} - ${options.title}` : options.title;
const themeStylesheets = getThemeStylesheets(options.theme || 'typecho-theme-minimal');

// Collect client-side snippets from all activated plugins
const pluginSnippets = await getClientSnippets(pluginCtx ?? { activatedPlugins: new Set<string>() }, options as Record<string, any>, pageContext);
---
<!DOCTYPE html>
<html lang={options.lang === 'zh_CN' ? 'zh-CN' : 'en'}>
<head>
  <meta charset={options.charset || 'UTF-8'} />
  <meta name="renderer" content="webkit" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  {description && <meta name="description" content={description} />}
  {keywords && <meta name="keywords" content={keywords} />}
  {themeStylesheets.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <link rel="alternate" type="application/rss+xml" title={`${options.title} RSS`} href={urls.feedUrl} />
<link rel="icon" href="/favicon.png" type="image/png">
  <slot name="head" />
  <Fragment set:html={pluginSnippets.headHtml} />
</head>
<body class={bodyClass}>
  <slot />
  <Fragment set:html={pluginSnippets.bodyHtml} />
  
<script type="module">
  import Swup from 'swup';

  function initLightbox() {
    if (window.Lightbox && typeof window.Lightbox.init === 'function') {
      window.Lightbox.init('.lightbox-img');
    }
  }

  function initLivePhoto() {
    if (typeof LivePhoto !== 'undefined' && typeof LivePhoto.init === 'function') {
      LivePhoto.init('.live-photo');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    try {
      const swup = new Swup({
        containers: ['#main', '#secondary', '#header', '#footer'],
        cache: true,
        linkSelector: 'a[href^="/"], a[href^="' + window.location.origin + '/"]',
        smoothScrolling: true,
        animationDuration: 400,
      });
      window.swup = swup;

      // 首次加载初始化
      initLightbox();
      initLivePhoto();

      // Swup 切换后重新初始化
      if (swup.hooks && typeof swup.hooks.on === 'function') {
        swup.hooks.on('page:view', function () {
          initLightbox();
          initLivePhoto();
        });
      } else {
        console.warn('Swup hooks.on not available');
      }
    } catch (error) {
      console.error('Swup initialization failed:', error);
    }
  });
</script>
</body>
</html>